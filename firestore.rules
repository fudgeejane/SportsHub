rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUserDoc() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function currentUser() {
      return get(userPath(request.auth.uid)).data;
    }

    function approved() {
      return hasUserDoc()
        && currentUser().status == 'APPROVED'
        && currentUser().emailVerified == true;
    }

    function hasRole(roles) {
      return approved() && currentUser().role in roles;
    }

    function isOrganizer() {
      return hasRole(['COMMUNITY_ORGANIZER', 'ADMIN']);
    }

    function isCoach() {
      return hasRole(['COACH']);
    }

    function isPlayer() {
      return hasRole(['PLAYER']);
    }

    function isFacilitator() {
      return hasRole(['FACILITATOR']);
    }

    function readOnlySportsAccess() {
      return isOrganizer() || isCoach() || isPlayer() || isFacilitator();
    }

    function teamDoc(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data;
    }

    function selfProfileFieldsOnly() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'displayName',
        'age',
        'gender',
        'contactNumber',
        'preferredSport',
        'preferredSportId',
        'preferredSportTeamStructure',
        'skillLevel',
        'emailVerified',
        'updatedAt'
      ]);
    }

    match /users/{uid} {
      allow create: if isSelf(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'PENDING'
        && request.resource.data.role in ['COMMUNITY_ORGANIZER', 'COACH', 'FACILITATOR', 'PLAYER'];

      allow create: if isSelf(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'APPROVED'
        && request.resource.data.role == 'COMMUNITY_ORGANIZER'
        && request.resource.data.approvedBy == request.auth.uid;

      allow read: if isSelf(uid) || isOrganizer();

      allow update: if isSelf(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && selfProfileFieldsOnly();

      allow update: if isOrganizer()
        && request.resource.data.role in ['ADMIN', 'COMMUNITY_ORGANIZER', 'COACH', 'FACILITATOR', 'PLAYER']
        && request.resource.data.status in ['PENDING', 'APPROVED', 'REJECTED'];

      allow delete: if false;
    }

    match /sports/{sportId} {
      allow read: if signedIn() || resource.data.status == 'ACTIVE';

      allow create: if isOrganizer()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.teamStructure is map
        && request.resource.data.status in ['ACTIVE', 'ARCHIVED'];

      allow update: if isOrganizer();

      allow delete: if isOrganizer();
    }

    match /events/{eventId} {
      allow read: if readOnlySportsAccess();
      allow create, update, delete: if isOrganizer();
    }

    match /teams/{teamId} {
      allow read: if readOnlySportsAccess();
      allow create: if isOrganizer()
        || (isCoach()
          && request.resource.data.coachId == request.auth.uid);
      allow update: if isOrganizer()
        || (isCoach()
          && resource.data.coachId == request.auth.uid
          && request.resource.data.coachId == request.auth.uid);
      allow delete: if isOrganizer();
    }

    match /teamMembers/{memberId} {
      allow read: if readOnlySportsAccess();
      allow create: if isOrganizer()
        || (isCoach()
          && request.resource.data.coachId == request.auth.uid
          && teamDoc(request.resource.data.teamId).coachId == request.auth.uid);
      allow update, delete: if isOrganizer()
        || (isCoach()
          && resource.data.coachId == request.auth.uid
          && teamDoc(resource.data.teamId).coachId == request.auth.uid);
    }

    match /teamJoinRequests/{requestId} {
      allow read: if isOrganizer()
        || isFacilitator()
        || (isCoach() && resource.data.coachId == request.auth.uid)
        || (isPlayer() && resource.data.playerId == request.auth.uid);

      allow create: if isPlayer()
        && request.resource.data.playerId == request.auth.uid
        && request.resource.data.status == 'PENDING';

      allow update: if isOrganizer()
        || (isCoach()
          && resource.data.coachId == request.auth.uid
          && request.resource.data.coachId == resource.data.coachId
          && request.resource.data.playerId == resource.data.playerId
          && request.resource.data.teamId == resource.data.teamId
          && request.resource.data.status in ['ACCEPTED', 'REJECTED']);

      allow delete: if isOrganizer()
        || (isPlayer()
          && resource.data.playerId == request.auth.uid
          && resource.data.status == 'PENDING');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
