rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUserDoc() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function currentUser() {
      return get(userPath(request.auth.uid)).data;
    }

    function roleIs(values) {
      return hasUserDoc() && currentUser().role in values;
    }

    function statusIsApproved() {
      return hasUserDoc() && currentUser().status in ['approved', 'APPROVED'];
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isOrganizer() {
      return statusIsApproved() && roleIs(['organizer', 'COMMUNITY_ORGANIZER', 'ADMIN']);
    }

    function isCoach() {
      return statusIsApproved() && roleIs(['coach', 'COACH']);
    }

    function isFacilitator() {
      return statusIsApproved() && roleIs(['facilitator', 'FACILITATOR']);
    }

    function isPlayer() {
      return statusIsApproved() && roleIs(['player', 'PLAYER']);
    }

    function isApprovedUser() {
      return isOrganizer() || isCoach() || isFacilitator() || isPlayer();
    }

    function selfProfileFieldsOnly() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'displayName',
        'age',
        'gender',
        'contactNumber',
        'preferredSport',
        'preferredSportId',
        'preferredSportTeamStructure',
        'skillLevel',
        'emailVerified',
        'updatedAt'
      ]);
    }

    function organizerApprovalOnly() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'role',
        'status',
        'approvalStatus',
        'approvedBy',
        'approvedAt',
        'updatedAt'
      ])
      && request.resource.data.role in ['organizer', 'coach', 'facilitator', 'player', 'COMMUNITY_ORGANIZER', 'ADMIN', 'COACH', 'FACILITATOR', 'PLAYER']
      && request.resource.data.status in ['pending', 'approved', 'rejected', 'PENDING', 'APPROVED', 'REJECTED'];
    }

    function activeOrApproved(value) {
      return value in ['active', 'approved', 'ACTIVE', 'APPROVED'];
    }

    function teamDoc(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data;
    }

    function eventDoc(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    function assignedToEvent(data) {
      return data.facilitatorId == request.auth.uid
        || (data.facilitatorIds is list && request.auth.uid in data.facilitatorIds);
    }

    match /users/{uid} {
      allow create: if isSelf(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['organizer', 'coach', 'facilitator', 'player', 'COMMUNITY_ORGANIZER', 'ADMIN', 'COACH', 'FACILITATOR', 'PLAYER']
        && request.resource.data.status in ['pending', 'approved', 'rejected', 'PENDING', 'APPROVED', 'REJECTED'];

      allow read: if isSelf(uid) || isOrganizer() || isCoach() || isFacilitator();

      allow update: if isSelf(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && selfProfileFieldsOnly();

      allow update: if isOrganizer() && organizerApprovalOnly();
      allow delete: if isOrganizer();
    }

    match /sports/{sportId} {
      allow read: if activeOrApproved(resource.data.status) || isApprovedUser();
      allow create, update, delete: if isOrganizer();
    }

    match /teams/{teamId} {
      allow read: if isApprovedUser() || activeOrApproved(resource.data.status);

      allow create: if isOrganizer()
        || (isCoach()
          && request.resource.data.coachId == request.auth.uid
          && request.resource.data.sportId is string
          && request.resource.data.sportId.size() > 0);

      allow update: if isOrganizer()
        || (isCoach()
          && resource.data.coachId == request.auth.uid
          && request.resource.data.coachId == request.auth.uid);

      allow delete: if isOrganizer();
    }

    match /events/{eventId} {
      allow read: if isApprovedUser();
      allow create, delete: if isOrganizer();
      allow update: if isOrganizer()
        || (isFacilitator()
          && assignedToEvent(resource.data)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'schedule',
            'status',
            'updatedAt'
          ]));
    }

    match /eventSchedules/{scheduleId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if isOrganizer();
      allow update: if isFacilitator() && resource.data.facilitatorId == request.auth.uid;
    }

    match /registrations/{registrationId} {
      allow read: if isOrganizer()
        || (isCoach() && resource.data.coachId == request.auth.uid)
        || (isFacilitator() && resource.data.facilitatorId == request.auth.uid);

      allow create: if isCoach()
        && request.resource.data.coachId == request.auth.uid
        && request.resource.data.teamId is string
        && teamDoc(request.resource.data.teamId).coachId == request.auth.uid;

      allow update: if isOrganizer()
        || (isCoach()
          && resource.data.coachId == request.auth.uid
          && request.resource.data.coachId == request.auth.uid)
        || (isFacilitator()
          && resource.data.facilitatorId == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'status',
            'paymentStatus',
            'reviewedAt',
            'reviewedBy',
            'updatedAt'
          ]));

      allow delete: if isOrganizer();
    }

    match /notifications/{notificationId} {
      allow read, update: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if isOrganizer() || isCoach() || isFacilitator();
      allow delete: if isOrganizer() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // Temporary compatibility collections used by older screens during migration.
    match /teamMembers/{memberId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if isOrganizer()
        || (isCoach()
          && request.resource.data.coachId == request.auth.uid);
    }

    match /playerApplications/{applicationId} {
      allow read: if isOrganizer()
        || (isCoach() && resource.data.coachId == request.auth.uid)
        || (signedIn() && resource.data.playerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.playerId == request.auth.uid;
      allow update, delete: if isOrganizer()
        || (isCoach() && resource.data.coachId == request.auth.uid)
        || (signedIn() && resource.data.playerId == request.auth.uid && resource.data.status in ['pending', 'PENDING']);
    }

    match /payments/{paymentId} {
      allow read: if isOrganizer()
        || (isCoach() && resource.data.coachId == request.auth.uid)
        || (isFacilitator() && resource.data.facilitatorId == request.auth.uid)
        || (signedIn() && resource.data.playerId == request.auth.uid);
      allow create, update: if isOrganizer()
        || (isCoach() && request.resource.data.coachId == request.auth.uid)
        || (isFacilitator() && resource.data.facilitatorId == request.auth.uid)
        || (signedIn() && request.resource.data.playerId == request.auth.uid);
      allow delete: if isOrganizer();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
